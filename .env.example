# FitFeky environment template — copy to .env.local and fill in.
# Never commit real secrets. See README.md for details.

# Google Gemini — powers the AI wellness coach (POST /api/ai/fit).
# Optional: without it the site runs, but the AI plan step is skipped.
GEMINI_API_KEY=
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Meta Pixel (Facebook) conversion tracking — optional.
NEXT_PUBLIC_META_PIXEL_ID=

# Canonical site URL used for SEO / structured data.
NEXT_PUBLIC_SITE_URL=https://www.fitfeky.com

# Prisma database URL — local default (SQLite).
DATABASE_URL="file:./dev.db"